# Auth.js (next-auth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>

# OAuth Providers (optional — can be left empty for demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# Email Authentication (magic link — optional for Phase 1)
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM="πroka <no-reply@piroka.app>"

# Demo Auth (for local dev without Supabase)
NEXT_PUBLIC_AUTH_DEMO=1
DEMO_AUTH_SECRET=<generate: openssl rand -base64 32>

# Database / realtime (Supabase)
DATABASE_URL=postgres://...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Maps — CARTO key must be ACTIVATED (current key returns a watermark). Fallback: Esri Dark Gray (no key).
NEXT_PUBLIC_CARTO_KEY=
NEXT_PUBLIC_MAP_STYLE=dark_all

# Age Verification Provider (Phase 1 gate)
# - local: Demo mode only (UI, no real verification)
# - yoti: Yoti SDK (requires YOTI_CLIENT_SDK_ID and YOTI_PEM_PATH)
# - persona: Persona.com API (requires PERSONA_API_KEY)
AGE_PROVIDER=local

# Yoti Configuration (Phase 2+)
# Get YOTI_CLIENT_SDK_ID from https://account.yoti.com
# Download .pem file from Yoti dashboard and place it at lib/auth/yoti.pem
# IMPORTANT: Do NOT open .pem file in text editor - binary file corruption risk
YOTI_CLIENT_SDK_ID=
YOTI_PEM_PATH=lib/auth/yoti.pem

# Persona Configuration (Phase 2+ - alternative to Yoti)
# PERSONA_API_KEY=

# Phone OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PREMIUM=price_...

# Media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=piroka-media

# AI (smart search, moderation assist, support drafting)
ANTHROPIC_API_KEY=

# Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Auth mode — with no Supabase keys the app runs on a signed demo cookie (dev only).
# Set NEXT_PUBLIC_AUTH_DEMO=1 to allow demo auth in a production build (e.g. a preview deploy).
NEXT_PUBLIC_AUTH_DEMO=
DEMO_AUTH_SECRET=

# Age check provider: yoti | persona | local (local = on-device UI only, proves nothing; dev only)
AGE_PROVIDER=
