# πroka environment — copy to .env.local for dev; paste the same names into Vercel → Settings → Environment Variables.
# See KEYS.md for where each value comes from. Anything left blank falls back to demo/disabled behaviour.

# ───────────── Core ─────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                                # openssl rand -base64 32
DEMO_AUTH_SECRET=                               # openssl rand -base64 32  (signs the demo cookie when Supabase is absent)
NEXT_PUBLIC_AUTH_DEMO=1                         # 1 = allow demo auth in production builds (previews only). Remove for launch.

# ───────────── Supabase (database, auth, realtime, storage) ─────────────
NEXT_PUBLIC_SUPABASE_URL=                       # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                  # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=                      # service_role key — server only, never NEXT_PUBLIC
DATABASE_URL=                                   # optional; direct Postgres URL for migrations

# ───────────── Bot protection (Cloudflare Turnstile; pair with Supabase → Authentication → Attack Protection) ─────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                # Turnstile Site Key (public). Leave empty until Supabase captcha is on.

# ───────────── Sign-in providers (configured in Supabase → Authentication → Providers) ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# ───────────── Email (magic links, verification codes) ─────────────
EMAIL_SERVER=                                   # smtp://user:pass@smtp.example.com:587
EMAIL_FROM="πroka <no-reply@piroka.app>"

# ───────────── Age verification ─────────────
AGE_PROVIDER=local                              # local (demo, proves nothing) | yoti
YOTI_CLIENT_SDK_ID=
YOTI_PEM_PATH=lib/auth/yoti.pem                 # download from Yoti; never open in a text editor

# ───────────── PayPal subscriptions ─────────────
PAYPAL_ENV=sandbox                              # sandbox | live
PAYPAL_CLIENT_ID=                               # REST app → Client ID (server)
PAYPAL_CLIENT_SECRET=                           # REST app → Secret (server)
PAYPAL_WEBHOOK_ID=                              # Webhooks → your endpoint → Webhook ID
NEXT_PUBLIC_PAYPAL_CLIENT_ID=                   # same Client ID, exposed to the browser for the PayPal Buttons
NEXT_PUBLIC_PAYPAL_PLAN_PLUS_ID=                # P-…  ($5 / month)
NEXT_PUBLIC_PAYPAL_PLAN_PREMIUM_ID=             # P-…  ($10 / month)

# ───────────── Web push ─────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=                   # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@piroka.app

# ───────────── Admin ─────────────
ADMIN_EMAILS=                                   # comma-separated emails allowed into /admin
ADMIN_USER_IDS=                                 # optional: comma-separated Supabase user ids

# ───────────── Maps ─────────────
NEXT_PUBLIC_CARTO_KEY=                          # optional; without it the map falls back to Esri Dark Gray
NEXT_PUBLIC_MAP_STYLE=dark_all

# ───────────── Optional integrations ─────────────
ANTHROPIC_API_KEY=                              # smart search / moderation assist
TWILIO_ACCOUNT_SID=                             # phone OTP
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
R2_ACCOUNT_ID=                                  # media storage (Cloudflare R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=piroka-media
